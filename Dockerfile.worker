# CoreByte Worker — agendador (backups, monitoramento, dynamic DNS, scaling)
#
# Roda separado do painel de propósito: um agendador dentro do servidor web
# reinicia a cada deploy e duplica quando há mais de uma réplica.

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl curl

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate

# Compila apenas o worker (TypeScript → JavaScript).
RUN npx tsc src/worker/index.ts \
      --outDir worker-dist \
      --module commonjs \
      --target es2022 \
      --moduleResolution node \
      --skipLibCheck \
      --esModuleInterop \
      --resolveJsonModule

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

# O worker também usa o socket do Docker (backup de volumes).
ARG DOCKER_GID=999
RUN addgroup --system --gid 1001 nodejs \
 && addgroup --system --gid ${DOCKER_GID} dockerhost \
 && adduser --system --uid 1001 --ingroup nodejs nextjs \
 && adduser nextjs dockerhost

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/worker-dist ./worker-dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/prisma ./prisma
COPY package.json ./

RUN mkdir -p /app/data/backups \
 && chmod -R a+rX /app/node_modules/@prisma /app/node_modules/.prisma /app/prisma \
 && chown -R nextjs:nodejs /app/data
USER nextjs

ENV DATABASE_URL="file:/app/data/corebyte.db"
ENV BACKUP_DIR="/app/data/backups"

CMD ["node", "worker-dist/index.js"]
