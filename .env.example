# ============================================================================
# CoreByte Panel — variáveis de ambiente
#
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env: ele contém os segredos do seu painel.
#
# O instalador (install.sh) preenche tudo automaticamente, incluindo as
# chaves aleatórias. Este arquivo serve para instalação manual.
# ============================================================================

# --- Domínio e HTTPS --------------------------------------------------------
# Domínio do painel (aponte o DNS para este servidor).
# Use localhost apenas para testes locais.
PANEL_DOMAIN=localhost
# E-mail usado para emitir o certificado Let's Encrypt.
ACME_EMAIL=
# URL completa do painel (com https quando tiver domínio próprio).
NEXTAUTH_URL=http://localhost:3000

# --- Segredos (obrigatórios, deixe vazio e o instalador gera) ---------------
# Assina a sessão dos usuários. Gere manualmente com:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# Cifra as credenciais de nuvem no banco (AES-256-GCM).
# Se ficar vazio, o painel usa a chave de sessão acima.
APP_SECRET=

# --- Configuração inicial ---------------------------------------------------
# Código exigido para criar o PRIMEIRO administrador pelo navegador.
# Deixe em branco para criar pelo terminal: npm run setup:admin
COREBYTE_SETUP_TOKEN=

# --- Banco de dados ---------------------------------------------------------
# Dentro do container o banco fica no volume persistente.
DATABASE_URL=file:/app/data/corebyte.db

# --- Backups ----------------------------------------------------------------
# Dentro do volume persistente, para não se perderem nas atualizações.
BACKUP_DIR=/app/data/backups

# --- Worker (agendador) -----------------------------------------------------
# Intervalo de verificação das tarefas, em ms (30000 = 30 segundos).
WORKER_TICK_MS=30000

# --- Diversos ---------------------------------------------------------------
TZ=America/Sao_Paulo
